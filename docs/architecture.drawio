<mxCell id="vpc" value="&lt;b&gt;VPC: private subnets in 2 AZs, no internet gateway, no NAT&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F2F8EE;strokeColor=#3F8624;fontColor=#3F8624;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="1140" height="500" as="geometry"/></mxCell>
<mxCell id="ecs" value="&lt;b&gt;ECS on Fargate&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#ED7100;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="270" width="250" height="260" as="geometry"/></mxCell>
<mxCell id="eksnodes" value="&lt;b&gt;EKS nodes (Bottlerocket)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#ED7100;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="830" y="270" width="590" height="300" as="geometry"/></mxCell>
<mxCell id="sysnode" value="&lt;b&gt;system node: m7i.large&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#ED7100;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="850" y="300" width="300" height="255" as="geometry"/></mxCell>
<mxCell id="gpunode" value="&lt;b&gt;GPU node: g6.xlarge, NVIDIA L4&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontColor=#5A7A0E;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="300" width="235" height="255" as="geometry"/></mxCell>
<mxCell id="internet" value="&lt;b&gt;Public sources&lt;/b&gt;&lt;br&gt;Docker Hub, GHCR&lt;br&gt;Hugging Face:&lt;br&gt;Qwen3-8B,&lt;br&gt;Qwen3-Embedding-0.6B" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="200" height="130" as="geometry"/></mxCell>
<mxCell id="laptop" value="&lt;b&gt;Operator laptop&lt;/b&gt;&lt;br&gt;make, kubectl, AWS CLI&lt;br&gt;uploads Synthea&lt;br&gt;bundles to S3&lt;br&gt;browser: localhost:8000 (UI)&lt;br&gt;localhost:8080 (FHIR)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="200" height="140" as="geometry"/></mxCell>
<mxCell id="codebuild" value="&lt;b&gt;CodeBuild import job&lt;/b&gt;&lt;br&gt;outside the VPC, run once&lt;br&gt;images by digest,&lt;br&gt;models at a fixed revision" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF1E6;strokeColor=#ED7100;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="230" height="120" as="geometry"/></mxCell>
<mxCell id="ecr" value="&lt;b&gt;ECR&lt;/b&gt;&lt;br&gt;vllm, tei, tei-gpu, hapi-fhir,&lt;br&gt;rag, fhir-loader&lt;br&gt;immutable tags, scan on push" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF3FC;strokeColor=#2E73B8;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="60" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;S3 data bucket (SSE-KMS)&lt;/b&gt;&lt;br&gt;models/   model weights&lt;br&gt;synthea/  patient bundles&lt;br&gt;TLS only (bucket policy)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF3FC;strokeColor=#2E73B8;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="60" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="eks" value="&lt;b&gt;EKS 1.36 control plane&lt;/b&gt;&lt;br&gt;managed by AWS&lt;br&gt;API: private, plus your IP /32 only&lt;br&gt;Kubernetes secrets encrypted with KMS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF1E6;strokeColor=#ED7100;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="60" width="350" height="120" as="geometry"/></mxCell>
<mxCell id="bastion" value="&lt;b&gt;SSM bastion&lt;/b&gt;&lt;br&gt;t4g.nano&lt;br&gt;no inbound, no public IP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4EEFC;strokeColor=#8C4FFF;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="280" width="170" height="85" as="geometry"/></mxCell>
<mxCell id="alb" value="&lt;b&gt;Internal ALB&lt;/b&gt;&lt;br&gt;port 80, VPC only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF5EA;strokeColor=#3F8624;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="170" height="95" as="geometry"/></mxCell>
<mxCell id="hapi" value="&lt;b&gt;HAPI FHIR server&lt;/b&gt;&lt;br&gt;v8.12, FHIR R4 API" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF1E6;strokeColor=#ED7100;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="305" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="loader" value="&lt;b&gt;FHIR loader task&lt;/b&gt;&lt;br&gt;one-off, S3 to HAPI" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF1E6;strokeColor=#ED7100;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="rag" value="&lt;b&gt;RAG API + clinician UI&lt;/b&gt;&lt;br&gt;FastAPI, citations, audit log" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF1E6;strokeColor=#ED7100;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="865" y="330" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="tei" value="&lt;b&gt;TEI embeddings (CPU)&lt;/b&gt;&lt;br&gt;one question at a time" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF1E6;strokeColor=#ED7100;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="865" y="400" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="jobs" value="&lt;b&gt;Jobs&lt;/b&gt;&lt;br&gt;index: embeds every chunk&lt;br&gt;eval: 139 graded questions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF1E6;strokeColor=#ED7100;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="865" y="470" width="270" height="75" as="geometry"/></mxCell>
<mxCell id="vllm" value="&lt;b&gt;vLLM v0.34&lt;/b&gt;&lt;br&gt;Qwen3-8B&lt;br&gt;OpenAI-compatible API&lt;br&gt;offline, no telemetry" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F7E3;strokeColor=#7AA116;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1185" y="330" width="205" height="120" as="geometry"/></mxCell>
<mxCell id="gpunote" value="&lt;b&gt;Scales to zero&lt;/b&gt;&lt;br&gt;make aws-gpu-off&lt;br&gt;index borrows the GPU&lt;br&gt;for TEI, then returns it" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F7E3;strokeColor=#7AA116;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1185" y="465" width="205" height="75" as="geometry"/></mxCell>
<mxCell id="rds" value="&lt;b&gt;RDS PostgreSQL 16 (KMS), db.t4g.small&lt;/b&gt;&lt;br&gt;database fhir: HAPI&amp;#x27;s FHIR store&lt;br&gt;database rag: chunks + pgvector, audit log&lt;br&gt;TLS required" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF3FC;strokeColor=#2E73B8;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="600" width="400" height="110" as="geometry"/></mxCell>
<mxCell id="endpoints" value="&lt;b&gt;VPC endpoints (AWS APIs only)&lt;/b&gt;&lt;br&gt;ECR api + dkr, S3 gateway, STS, EKS auth, EC2,&lt;br&gt;Secrets Manager, CloudWatch Logs,&lt;br&gt;SSM, SSM messages, EC2 messages" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF5EA;strokeColor=#3F8624;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="600" width="440" height="110" as="geometry"/></mxCell>
<mxCell id="kms" value="&lt;b&gt;KMS customer key&lt;/b&gt;&lt;br&gt;S3, RDS, ECR, EKS secrets,&lt;br&gt;logs, DB secret; rotation on" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEE;strokeColor=#DD344C;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="770" width="250" height="85" as="geometry"/></mxCell>
<mxCell id="secrets" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;RDS-managed password,&lt;br&gt;read by pods via Pod Identity" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEE;strokeColor=#DD344C;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="770" width="260" height="85" as="geometry"/></mxCell>
<mxCell id="logs" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;EKS audit, ECS, import job,&lt;br&gt;VPC Flow Logs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4EEFC;strokeColor=#8C4FFF;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="770" width="250" height="85" as="geometry"/></mxCell>
<mxCell id="iam" value="&lt;b&gt;IAM&lt;/b&gt;&lt;br&gt;Pod Identity: model-fetch (S3 models/),&lt;br&gt;rag (DB secret only)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCEBEE;strokeColor=#DD344C;fontColor=#232F3E;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="770" width="290" height="85" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;Flows&lt;/b&gt;&lt;br&gt;1  import images and models&lt;br&gt;    (once per version)&lt;br&gt;2  load patients into HAPI&lt;br&gt;3  index: FHIR to chunks&lt;br&gt;    to vectors in pgvector&lt;br&gt;4  ask: UI, RAG API,&lt;br&gt;    search, vLLM, cited answer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFDF2;strokeColor=#B8A44C;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="200" height="160" as="geometry"/></mxCell>
